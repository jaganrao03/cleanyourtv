<?xml version="1.0" encoding="utf-8"?>
<!-- Compact tvOS-style corner sheet: connectivity, audio/display, then settings actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ccPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_control_center"
    android:padding="12dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="6dp"
        android:text="@string/control_center"
        android:textColor="#F2FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@string/font_medium"
        android:importantForAccessibility="yes" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ccConnectCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cc_card"
            android:padding="6dp">

            <GridLayout
                android:id="@+id/ccGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ccSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:background="@drawable/cc_card"
            android:padding="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ccFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />
</LinearLayout>
